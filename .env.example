# Copy to .env.local (gitignored) and fill in when each phase needs it.
# Never commit real values.

# Set to "true" once the /api/instamart/* routes do more than return 501.
# Read by the browser bundle (VITE_ prefix) — safe, it's just a feature flag,
# never a secret.
VITE_INSTAMART_ENABLED=false

# Server-side only (Vercel project env vars) — Phase 2. Deliberately NOT
# VITE_-prefixed: that prefix ships a value into the browser bundle, which is
# exactly what must never happen to a client secret or access token.
SWIGGY_CLIENT_ID=
SWIGGY_REDIRECT_URI=
